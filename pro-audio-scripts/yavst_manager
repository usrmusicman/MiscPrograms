#!/usr/bin/env bash
# YaVST CLI Manager - Regular & Immutable Unified (Decoupled System Prep + RT Limits)
set -Eeuo pipefail
IFS=$'\n\t'

# -------------------------
# Configuration & Paths
# -------------------------
HOME="${HOME:-/home/$(id -un)}"
BUNDLE_PATH="$HOME/.local/bin/YaVST"
DOWNLOAD_PATH="$HOME/Downloads"
YABRIDGE_ROOT="$BUNDLE_PATH/yabridge"
YABRIDGECTL_PATH="$YABRIDGE_ROOT/yabridgectl"

# Versions for Immutable Setup
WINE_VER="11.18"
YABRIDGE_VER="5.1.10"
WINEASIO_VER="1.3.0"
WINEASIO_REV="2.1"
WINE_BUILD_NAME="staging-tkg-amd64"

# -------------------------
# System Detection
# -------------------------
is_immutable() {
    if [[ -f /etc/steamos-release ]] || [[ -d /sysroot/ostree ]]; then
        return 0
    fi
    return 1
}

log_msg() { echo -e "\e[1;34m[$(date '+%H:%M:%S')]\e[0m $*"; }
error_exit() { echo -e "\e[1;31mERROR:\e[0m $*" >&2; exit 1; }

# -------------------------
# Feature: System & Kernel Preparation (Requires Sudo/Reboot)
# -------------------------
setup_bazzite_system() {
    if ! is_immutable; then
        log_msg "Regular distribution detected. Skipping atomic system preparation."
        return 0
    fi

    log_msg "Configuring Bazzite audio, render, and real-time scheduling groups..."
    for grp in audio render pipewire realtime; do
        if ! grep -q "^${grp}:" /etc/group; then
            if grep -q "^${grp}:" /usr/lib/group; then
                grep "^${grp}:" /usr/lib/group | sudo tee -a /etc/group >/dev/null
                log_msg "Imported system group definition: $grp"
            fi
        fi
        sudo usermod -aG "$grp" "$USER"
    done

    log_msg "Configuring real-time resource limits (@realtime & @audio rtprio 95)..."
    local limits_dir="/etc/security/limits.d"
    local limits_file="$limits_dir/99-realtime-audio.conf"

    sudo mkdir -p "$limits_dir"
    sudo tee "$limits_file" > /dev/null <<EOF
# Generated by YaVST CLI Manager for low-latency pro audio tracking
@realtime string rtprio 95
@realtime string memlock unlimited
@audio    string rtprio 95
@audio    string memlock unlimited
EOF
    log_msg "Created limits rule at $limits_file."

    log_msg "Checking low-latency kernel arguments (cmdline)..."
    local current_kargs
    current_kargs=$(rpm-ostree kargs)

    local append_args=()
    if [[ ! "$current_kargs" =~ "preempt=full" ]]; then
        append_args+=("--append=preempt=full")
    fi
    if [[ ! "$current_kargs" =~ "threadirqs" ]]; then
        append_args+=("--append=threadirqs")
    fi

    if [ ${#append_args[@]} -gt 0 ]; then
        log_msg "Applying kernel arguments: ${append_args[*]}"
        sudo rpm-ostree kargs "${append_args[@]}"
        log_msg "System modifications complete! A REBOOT is required to apply kernel and group changes."
    else
        log_msg "Kernel arguments are already applied. A REBOOT/LOGOUT is still recommended if groups or limits were just added."
    fi
}

# -------------------------
# Feature: Wine & Yabridge Installation
# -------------------------
install_core() {
    if is_immutable; then
        log_msg "Installing portable bundle..."
        mkdir -p "$BUNDLE_PATH" "$DOWNLOAD_PATH"

        # Wine Installation
        local wine_file="wine-${WINE_VER}-${WINE_BUILD_NAME}.tar.xz"
        wget -c "https://github.com{WINE_VER}/$wine_file" -O "$DOWNLOAD_PATH/$wine_file"
        rm -rf "$BUNDLE_PATH/bin" "$BUNDLE_PATH/lib" "$BUNDLE_PATH/share"
        tar -xJf "$DOWNLOAD_PATH/$wine_file" -C "$BUNDLE_PATH" --strip-components=1

        # Yabridge Installation
        local y_file="yabridge-${YABRIDGE_VER}.tar.gz"
        wget -c "https://github.com{YABRIDGE_VER}.tar.gz" -O "$DOWNLOAD_PATH/$y_file"
        rm -rf "$YABRIDGE_ROOT"
        mkdir -p "$YABRIDGE_ROOT"
        tar -xzf "$DOWNLOAD_PATH/$y_file" -C "$YABRIDGE_ROOT"

        # Create link to yabridge bundle
        if [[ ! -d "$HOME/.local/share/yabridge" ]]; then
            ln -sf "$YABRIDGE_ROOT" "$HOME/.local/share/yabridge"
        else
            rm "$HOME/.local/share/yabridge"
            ln -sf "$YABRIDGE_ROOT" "$HOME/.local/share/yabridge"
        fi

        setup_env_script
    else
        log_msg "Regular distro detected. Please ensure 'wine' and 'yabridge' are installed via your package manager."
    fi
}

# -------------------------
# Feature: WineASIO Setup
# -------------------------
setup_wineasio() {
    local prefix="${WINEPREFIX:-$HOME/.wine}"

    if is_immutable; then
        log_msg "Immutable: Extracting WineASIO into portable bundle..."
        local pkg="wineasio-${WINEASIO_VER}-${WINEASIO_REV}-x86_64.pkg.tar.zst"
        wget -c "https://garudalinux.org" -O "$DOWNLOAD_PATH/$pkg"

        local temp=$(mktemp -d)
        tar -I zstd -xf "$DOWNLOAD_PATH/$pkg" -C "$temp"

        mkdir -p "$prefix/drive_c/windows/system32/"
        cp -v "$temp"/usr/lib/wine/x86_64-windows/wineasio64.dll "$prefix/drive_c/windows/system32/"
        mkdir -p "$BUNDLE_PATH/lib/wine/x86_64-unix"
        cp -v "$temp"/usr/lib/wine/x86_64-unix/wineasio64.dll.so "$BUNDLE_PATH/lib/wine/x86_64-unix/"
        rm -rf "$temp"

        log_msg "Registering WineASIO via portable Wine loader..."
        PATH="$BUNDLE_PATH/bin:$PATH" WINELOADER="$BUNDLE_PATH/bin/wine" WINESERVER="$BUNDLE_PATH/bin/wineserver" WINEDLLPATH="$BUNDLE_PATH/lib/wine" "$BUNDLE_PATH/bin/wine" regsvr32 wineasio64.dll
    else
        log_msg "Regular: Registering system-wide WineASIO..."
        local sys_dll64="/usr/lib/wine/x86_64-unix/wineasio64.dll.so"
        if [[ -f "$sys_dll64" ]]; then
            cp -v "$sys_dll64" "$prefix/drive_c/windows/system32/wineasio64.dll"
            wine regsvr32 wineasio64.dll
        else
            error_exit "System WineASIO DLL not found. Please install the wineasio package."
        fi
    fi
}

# -------------------------
# Environment Management
# -------------------------
setup_env_script() {
    local env_d="$HOME/.config/environment.d"
    local env_file="$env_d/99-yavst.conf"
    mkdir -p "$env_d"

    cat > "$env_file" <<EOF
PATH="$BUNDLE_PATH/bin:$YABRIDGE_ROOT:\$PATH"
WINELOADER="$BUNDLE_PATH/bin/wine"
WINESERVER="$BUNDLE_PATH/bin/wineserver"
WINEDLLPATH="$BUNDLE_PATH/lib/wine"
EOF
    log_msg "GUI/Desktop environment variables created at $env_file."

    local bashrc_d="$HOME/.bashrc.d"
    local bash_env_file="$bashrc_d/yavst"
    mkdir -p "$bashrc_d"

    cat > "$bash_env_file" <<EOF
export PATH="$BUNDLE_PATH/bin:$YABRIDGE_ROOT:\$PATH"
export WINELOADER="$BUNDLE_PATH/bin/wine"
export WINESERVER="$BUNDLE_PATH/bin/wineserver"
export WINEDLLPATH="$BUNDLE_PATH/lib/wine"
EOF

    if [[ -f "$HOME/.bashrc" ]] && ! grep -q "bashrc\.d" "$HOME/.bashrc"; then
        cat >> "$HOME/.bashrc" <<'EOF'

# User specific aliases and functions
if [ -d ~/.bashrc.d ]; then
    for rc in ~/.bashrc.d/*; do
        if [ -f "$rc" ]; then
            . "$rc"
        fi
    done
fi
unset rc
EOF
    fi

    log_msg "YaVST variables will load system-wide after your next login session."
}

# -------------------------
# Main Execution Logic
# -------------------------
show_help() {
    cat <<EOF
YaVST CLI Manager (Low-Latency Audio Edition)
Usage: $(basename "$0") [flag]

Commands:
  --sys-prep       Configure real-time limits/groups & append low-latency kargs (Bazzite)
  --install        Install/Update user-space portable Wine & Yabridge
  --wineasio       Register WineASIO DLLs in current WINEPREFIX
  --add [path]     Add a VST directory to Yabridge
  --remove [path]  Remove a VST directory from Yabridge
  --sync           Manually trigger yabridgectl sync
  --list           List currently tracked VST directories
  --help           Show this message
EOF
}

if is_immutable; then
    YCTL="$YABRIDGECTL_PATH"
else
    YCTL=$(command -v yabridgectl || echo "yabridgectl")
fi

[[ $# -eq 0 ]] && { show_help; exit 0; }

case "$1" in
    --sys-prep)
        setup_bazzite_system
        ;;
    --install)
        install_core
        ;;
    --wineasio)
        setup_wineasio
        ;;
    --add)
        shift
        [[ -z "${1:-}" ]] && error_exit "Please provide a path to add."
        "$YCTL" add "$1"
        "$YCTL" sync
        ;;
    --remove)
        shift
        [[ -z "${1:-}" ]] && error_exit "Please provide a path to remove."
        "$YCTL" rm "$1"
        "$YCTL" sync
        ;;
    --list)
        "$YCTL" list
        ;;
    --sync)
        "$YCTL" sync
        ;;
    --help|-h)
        show_help
        ;;
    *)
        error_exit "Unknown option: $1. Use --help for usage."
        ;;
esac
